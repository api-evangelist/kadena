                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{apiVersion}}",
                  "key": "apiVersion"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "method": "GET",
            "auth": null,
            "body": {
              "mode": "file"
            }
          },
          "response": [
            {
              "id": "b9bc1641-ec00-407d-84c9-b22e16831af0",
              "name": "Each events consists of a single line: `event:New Cut`.\nEvents are separated by empty lines.\n",
              "originalRequest": {
                "url": {
