          "name": "Get Block Hash Branches",
          "request": {
            "name": "Get Block Hash Branches",
            "description": {
              "content": "A page of block hashes from branches of the block chain in\n**descending** order.\n\nOnly blocks are returned that are ancestors of the some block in the\nset of upper bounds and are not ancestors of any block in the set of\nlower bounds.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "chain",
                ":chain",
                "hash",
                "branch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of records that may be returned. The actual number may be\nlower.\n"
                },
                {
                  "disabled": false,
                  "key": "next",
                  "value": "<string>",
                  "description": "The cursor for the next page. This value can be found as value of the\n`next` property of the previous page.\n"
                },
                {
                  "disabled": false,
                  "key": "minheight",
                  "value": "<integer>",
                  "description": "Minimum block height of the returned headers"
                },
                {
                  "disabled": false,
                  "key": "maxheight",
                  "value": "<integer>",
                  "description": "Maximum block height of the returned headers"
                }
              ],
              "variable": [
