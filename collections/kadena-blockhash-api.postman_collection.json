  "item": [
    {
      "id": "659882b9-3ada-4a93-be04-83b10a8fbb3e",
      "name": "blockhash",
      "description": {
        "content": "These endpoints return block hashes from the chain database.\n\nGenerally, block hashes are returned in ascending order and include hashes\nfrom orphaned blocks.\n\nFor only querying blocks that are included in the winning branch of the\nchain the `branch` endpoint can be used, which returns blocks in descending\norder starting from the leafs of branches of the block chain.\n",
        "type": "text/plain"
      },
      "item": [
