                "value": "",
                "type": "path",
                "description": "the id of the chain to which the request is sent"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Lookup Pending Transactions in the Mempool"
        },
        {
          "info": {
            "name": "Insert Transactions into the Mempool",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.chainweb.com/chainweb/{apiVersion}/mainnet01/chain/:chain/mempool/insert",
            "params": [
              {
                "name": "chain",
