  "item": [
    {
      "id": "bbc67087-d4d0-4f37-8617-f638cb18813c",
      "name": "cut",
      "description": {
        "content": "A cut represents a distributed state of a chainweb. It references one\nblock header for each chain, such that those blocks are pairwise\nconcurrent.\n\nTwo blocks from two different chains are said to be concurrent if either\none of them is an adjacent parent (is a direct dependency) of the other or\nif the blocks do not depend at all on each other.\n",
        "type": "text/plain"
      },
